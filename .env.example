# Copy to .env and replace this local development password.
DB_PASSWORD=replace-with-a-local-password

# Initial administrator. Leave all three empty to disable bootstrap creation.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Set true behind production HTTPS.
SESSION_COOKIE_SECURE=false
# 分开部署时允许的前端源站，逗号分隔，不含路径或末尾斜杠；默认仅同源。
CORS_ALLOWED_ORIGINS=

# FSRS 默认目标保持率与最大间隔（天）；学习步骤使用官方默认的 1/10 分钟。
FSRS_DESIRED_RETENTION=0.9
FSRS_MAXIMUM_INTERVAL_DAYS=36500
# 允许设备答题时间领先服务器的秒数；超过容差时拒绝提交并保留本地记录。
REVIEW_FUTURE_CLOCK_TOLERANCE_SECONDS=300

# 显式开启后才调用 Google，ADC 服务账号文件只挂载到服务器。
GOOGLE_TTS_ENABLED=false
GOOGLE_CREDENTIALS_FILE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 私有桶，文件由服务器校验权限后提供给浏览器。
R2_AUDIO_BUCKET=

# 账号邮件：默认关闭，配置后可由后台创建账号、发送一次性找回链接。
# SMTP 587 一般使用 STARTTLS；465 使用 SSL=true、STARTTLS=false。
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_SSL=false
# 实际访问地址，生产使用 https；不从请求 Host 构造密码重置链接。
PUBLIC_APP_URL=
# 可选本地收件箱 UI 端口，compose.mail-dev.yml 使用；不影响外部 SMTP。
MAILBOX_PORT=8027
